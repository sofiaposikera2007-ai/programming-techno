pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Getting project from Git'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Preparing build'
                bat 'python -m compileall -q Lab2'
            }
        }

        stage('Test Lab2.1') {
            steps {
                echo 'Testing Lab2.1'
                bat '"C:\\Users\\USER\\AppData\\Local\\Programs\\Python\\Python312\\python.exe" -m pytest Lab2/lab2.1/test_trainings.py -v'
            }
        }

        stage('Test Training Service') {
            steps {
                echo 'Testing Training Service'
                bat '"C:\\Users\\USER\\AppData\\Local\\Programs\\Python\\Python312\\python.exe" -m pytest Lab2/lab2.2/serv1/test_trservice.py -v'
            }
        }

        stage('Test Clients Service') {
            steps {
                echo 'Testing Clients Service'
                bat '"C:\\Users\\USER\\AppData\\Local\\Programs\\Python\\Python312\\python.exe" -m pytest Lab2/lab2.2/serv2/test_clients.py -v'
            }
        }
    }

    post {
         always {
            echo 'Pipeline execution finished.'
        }
        success {
            echo 'All tests completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
