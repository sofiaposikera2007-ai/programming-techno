pipeline {
    agent any
    
    environment {
        PYTHON_EXE = '"C:\\Users\\USER\\AppData\\Local\\Programs\\Python\\Python312\\python.exe"'
        DOCKER_USER = 'sofiiaaa27'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Getting project from Git'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Preparing build'
                bat "${PYTHON_EXE} -m compileall -q Lab2"
            }
        }

        
        stage('Test Training Service') {
            steps {
                echo 'Testing Training Service'
                bat "${PYTHON_EXE} Lab2/lab2.2/serv1/test_trservice.py "
            }
        }

        stage('Test Clients Service') {
            steps {
                echo 'Testing Clients Service'
                bat "${PYTHON_EXE} Lab2/lab2.2/serv2/test_clients.py "
            }
        }

        stage('Build Docker Images') {
            steps {
                echo 'Building Docker images...'
                bat "docker build -t %DOCKER_USER%/training-service:%IMAGE_TAG% -t %DOCKER_USER%/training-service:latest Lab2/lab2.2/serv1"
                bat "docker build -t %DOCKER_USER%/clients-service:%IMAGE_TAG% -t %DOCKER_USER%/clients-service:latest Lab2/lab2.2/serv2"
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo 'Pushing Docker images to Docker Hub...'
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    bat "echo %DH_PASS% | docker login -u %DH_USER% --password-stdin"
                    bat "docker push %DOCKER_USER%/training-service:%IMAGE_TAG%"
                    bat "docker push %DOCKER_USER%/training-service:latest"
                    bat "docker push %DOCKER_USER%/clients-service:%IMAGE_TAG%"
                    bat "docker push %DOCKER_USER%/clients-service:latest"
                }
                }
                post {
                always {
                    bat "docker logout"
                }
            }
        }
    }

    post {
         always {
            echo 'Pipeline execution finished.'
        }
        success {
            echo 'All tests completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
